SELECT do.name, do.loading_delivery_note, do.operational_status, do.do_status,
       ldn.name as ldn_via_jo, ldn.delivery_note_status, ldn.qc_status, ldn.dispatch_confirmed, ldn.qc_report_request
FROM `tabDelivery Order` do
LEFT JOIN `tabJob Order` jo ON jo.name = do.job_order
LEFT JOIN `tabSecurity Draft Delivery Note` sddn ON sddn.job_order = do.job_order
