2026-06-01 15:27:16,555 INFO ipython def credit_days_for(name):
    n = name.lower()
    if "90 day" in n or "90 days" in n:
        return 90
    if "60 day" in n or "60 days" in n:
        return 60
    if "30 day" in n or "30 days" in n:
        return 30
    return 0
2026-06-01 15:27:16,555 INFO ipython created = []
2026-06-01 15:27:16,556 INFO ipython skipped = []
2026-06-01 15:27:16,556 INFO ipython for name in terms:
    if frappe.db.exists("Payment Term", name):
        skipped.append(name)
        continue
    doc = frappe.get_doc({
        "doctype": "Payment Term",
        "payment_term_name": name,
        "description": name,
        "invoice_portion": 100,
        "due_date_based_on": "Day(s) after invoice date",
        "credit_days": credit_days_for(name),
    })
    doc.insert(ignore_permissions=True)
    created.append(name)
