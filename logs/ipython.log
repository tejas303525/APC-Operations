2026-07-18 10:45:44,035 INFO ipython   import frappe

  job_orders = ["JO-2026-00065", "JO-2026-00025", "JO-2026-00012"]

  # Doctype name → field that links to Job Order, ordered deepest first
  linked_doctypes = [
      ("Weighment Slip",                "job_order"),
      ("Loading Delivery Note",         "job_order"),
      ("QC Report Request",             "job_order"),
      ("Security Inspection",           "job_order"),
      ("Security Draft Delivery Note",  "job_order"),
      ("Security Dispatch",             "job_order"),
      ("Gate Pass",                     "transport_schedule"),   # links via TRN, handled separately
      ("Transport PO Request",          "job_order"),
      ("Transport Schedule",            "job_order"),            # in transportation module
      ("Shipping Booking",              "job_order"),
  ]

  for jo in job_orders:
      print(f"\n--- Processing {jo} ---")

      # Gate Pass links via Transport Schedule, not directly to Job Order
      # Get transport schedules first, then find gate passes
      trn_list = frappe.get_all("Transport Schedule", filters={"job_order": jo}, pluck="name")
      for trn in trn_list:
          gp_list = frappe.get_all("Gate Pass", filters={"transport_schedule": trn}, pluck="name")
          for gp in gp_list:
              frappe.delete_doc("Gate Pass", gp, force=True, ignore_permissions=True)
              print(f"  Deleted Gate Pass: {gp}")

      for doctype, fieldname in linked_doctypes:
          if doctype == "Gate Pass":
              continue  # already handled above
          try:
              records = frappe.get_all(doctype, filters={fieldname: jo}, pluck="name")
              for name in records:
                  frappe.delete_doc(doctype, name, force=True, ignore_permissions=True)
                  print(f"  Deleted {doctype}: {name}")
          except Exception as e:
              print(f"  Skipped {doctype}: {e}")

      try:
          frappe.delete_doc("Job Order", jo, force=True, ignore_permissions=True)
          print(f"  Deleted Job Order: {jo}")
      except Exception as e:
          print(f"  Could not delete Job Order {jo}: {e}")

  frappe.db.commit()
  print("\nDone.")
2026-07-18 10:45:44,035 INFO ipython === session end ===
